# ---- Vercel / Turso (online free database) ----
# Create a free database at turso.tech, then copy these two values. When TURSO_DATABASE_URL is set the app uses Turso;
# when it is empty the app uses the local SQLite file in DATA_DIR (Docker / Render / laptop).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# On Vercel JWT_SECRET is REQUIRED (the filesystem is read-only there). Any long random string.

# Optional. A secret is generated and stored in DATA_DIR/.secret if JWT_SECRET is not set.
JWT_SECRET=
PORT=3000
DATA_DIR=./data
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Fly, nginx)
TRUST_PROXY=
NODE_ENV=production
# Public address of your site (used to build the downloadable extension). Needed behind some proxies.
PUBLIC_URL=
# Optional: enables in-app lecture search (YouTube Data API v3 key). Keep it secret.
YOUTUBE_API_KEY=

# Optional: email one-time-code (OTP) check at sign-in and sign-up. Uses Resend (https://resend.com).
# Leave both empty to keep the normal password-only sign-in. Set BOTH to turn it on.
RESEND_API_KEY=
# A sender address on a domain you verified in Resend, e.g. ProgressBuddy <no-reply@yourdomain.com>
MAIL_FROM=

# Option B (free, no domain needed): send the codes from a Gmail account instead of Resend.
# Create a Gmail account for the project, turn on 2-Step Verification, then make an "App Password".
# Use the 16-letter App Password here, NOT your normal Gmail password. Resend (above) is used first if both are set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=ProgressBuddy
